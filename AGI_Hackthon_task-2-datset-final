_DIR, os.path.basename(x)))\n\n# Fill NAs\nfor col in df.columns:\n    if df[col].dtype == object:\n        df[col] = df[col].fillna(\"\")\n\nprint(f\"[OK] Loaded {len(df)} samples\")\nprint(f\"     Domains: {sorted(df['domain'].unique())}\")\nprint(f\"     Integration depths: {sorted(df['integration_depth'].unique())}\")\nprint(f\"     Conflict levels: {sorted(df['conflict_level'].unique())}\")\nprint(f\"     Difficulty cells: {sorted(df['difficulty_cell'].unique())}\")\n","metadata":{"_uuid":"2371df58-a3b7-4735-91e9-065909fc452f","_cell_guid":"07dfe055-6d14-44c2-ab9c-a002f96f0ca1","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n# == CELL 2: Answer Matching ===================================================================\n\ndef normalise(text):\n    t = str(text).strip().lower()\n    t = re.sub(r\"[,$]\", \"\", t)\n    t = re.sub(r\"\\s+\", \"\", t)\n    return t\n\ndef extract_number(text):\n    m = re.search(r\"(-?\\d+\\.?\\d*)\", normalise(text))\n    return float(m.group(1)) if m else None\n\ndef answers_match(predicted, correct):\n    pred = normalise(predicted)\n    corr = normalise(correct)\n\n    # Exact string match\n    if corr in pred:\n        return True\n\n    # Categorical match (CRITICAL/STABLE)\n    if corr in [\"critical\", \"stable\"]:\n        return corr in pred\n\n    # Numeric match\n    pred_num = extract_number(predicted)\n    corr_num = extract_number(correct)\n    if pred_num is not None and corr_num is not None:\n        if corr_num == 0:\n            return abs(pred_num) < 0.5\n        relative_err = abs(pred_num - corr_num) / abs(corr_num)\n        return relative_err <= 0.02  # 2% tolerance for rounding\n    return False\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n# == CELL 3: Assertion Handler =================================================================\n\n@kbench.assertions.asserti