ou are given a data dashboard image AND a text memo. \"\n        f\"Read BOTH carefully to answer the question.\\n\\n\"\n        f\"--- TEXT MEMO ---\\n{text_passage}\\n\\n\"\n        f\"--- QUESTION ---\\n{question}\\n\\n\"\n        f\"Respond with ONLY the final answer (a number or a single word like CRITICAL/STABLE). \"\n        f\"No explanation.\"\n    )\n\n    with kbench.chats.new(f\"cmat_{id}\"):\n        response = llm.prompt(prompt, image=img)\n\n    model_response = response.text if hasattr(response, \"text\") else str(response)\n\n    # Fire assertion\n    check_cross_modal(\n        sample_id=id,\n        correct_answer=correct_answer,\n        image_only_trap=image_only_trap,\n        domain=domain,\n        integration_depth=integration_depth,\n        conflict_level=conflict_level,\n        difficulty_cell=difficulty_cell,\n        model_response=model_response,\n    )\n\n    is_correct = answers_match(model_response, correct_answer)\n    hit_trap = (not is_correct) and answers_match(model_response, image_only_trap)\n\n    return {\n        \"id\": id,\n        \"correct_answer\": correct_answer,\n        \"predicted\": model_response.strip()[:200],\n        \"is_correct\": is_correct,\n        \"hit_image_trap\": hit_trap,\n        \"domain\": domain,\n        \"integration_depth\": integration_depth,\n        \"conflict_level\": conflict_level,\n        \"difficulty_cell\": difficulty_cell,\n    }","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n# == CELL 5: Main Benchmark Task ==============================================================\n\n@kbench.task(\n    name=\"CMAT-v1.0\",\n    description=(\n        \"Cross-Modal Attention Triage: 100 samples across 5 creative domains. \"\n        \"Tests whether models can integrate text memos + dashboard images \"\n        \"to perform corrections, arithmetic, conditionals, aggregation, and multi-hop reasoning. \"\n        \"Neither modality alone is sufficient to answer correctly.\"\n    ),\n)\ndef cmat_benchmark(llm, eval_df: pd.DataFrame) -> tuple[float, float]:\n    with kbench.client.enable_cache():\n        runs = single_cmat_task.evaluate(\n            stop_condition=lambda r: len(r) == eval_df.shape[0],\n            max_attempts=1,\n            llm=[llm],\n            evaluation_data=eval_df,\n            n_jobs=4,\n            timeout=180,\n            remove_run_files=True,\n        )\n\n    run_df = runs.as_dataframe()\n    results = pd.DataFrame(run_df[\"result\"].tolist())\n\n    total = len(results)\n    correct = int(results[\"is_correct\"].sum())\n    traps = int(results[\"hit_image_trap\"].sum())\n    accuracy = float(results[\"is_correct\"].mean())\n    std = float(results[\"is_correct\"].std())\n\n    print(f\"\\n{'='*70}\")\n    print(f\"  CMAT v1.0 BENCHMARK RESULTS\")\n    print(f\"{'='*70}\")\n    print(f\"  Total samples      : {total}\")\n    print(f\"  Correct            : {correct}\")\n    print(f\"  Image-only traps   : {traps}\")\n    print(f\"  Other errors       : {total - correct - traps}\")\n    print(f\"  ACCURACY           : {accuracy:.4f} +/- {std:.4f}\")\n    print(f\"{'-'*70}\")\n\n    # By Integration Depth\n    print(f\"\\n  -- Accuracy by Integration Depth --\")\n    for il in sorted(results[\"integration_depth\"].unique()):\n        sub = results[results[\"integration_depth\"] == il]\n        acc = sub[\"is_correct\"].mean()\n        n = len(sub)\n        bar = \"#\" * int(acc * 20) + \".\" * (20 - int(acc * 20))\n        print(f\"  I{il}  {bar}  {acc:.0%}  (n={n})\")\n\n    # By Conflict Level\n    print(f\"\\n  -- Accuracy by Conflict Level --\")\n    for cl in sorted(results[\"conflict_level\"].unique()):\n        sub = results[results[\"conflict_level\"] == cl]\n        acc = sub[\"is_correct\"].mean()\n        n = len(sub)\n        bar = \"#\" * int(acc * 20) + \".\" * (20 - int(acc * 20))\n        print(f\"  C{cl}  {bar}  {acc:.0%}  (n={n})\")\n\n    # By Difficulty Cell\n    print(f\"\\n  -- Accuracy by Difficulty Cell --\")\n    for dc in sorted(results[\"difficulty_cell\"].unique()):\n        sub = results[results[\"difficulty_cell\"] == dc]\n        acc = sub[\"is_correct\"].mean()\n        n = len(sub)\n        print(f\"  {dc:<8}  {acc:.0%}  ({sub['is_correct'].sum()}/{n})\")\n\n    # By Domain\n    print(f\"\\n  -- Accuracy by Domain --\")\n    for dom in sorted(results[\"domain\"].unique()):\n        sub = results[results[\"domain\"] == dom]\n        acc = sub[\"is_correct\"].mean()\n        n = len(sub)\n        print(f\"  {dom:<25}  {acc:.0%}  ({sub['is_correct'].sum()}/{n})\")\n\n    print(f\"\\n{'='*70}\\n\")\n\n    kbench.assertions.assert_true(\n        accuracy >= 0,\n        expectation=f\"Overall accuracy: {accuracy:.4f} +/- {std:.4f} on {total} samples\",\n    )\n\n    return accuracy, std\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n# == CELL 6: Test Run (26 samples - 1 per difficulty cell + 1 per domain) =====================\n\ntest_indices = []\nfor dc in sorted(df[\"difficulty_cell\"].unique()):\n    subset = df[df[\"difficulty_cell\"] == dc]\n    test_indices.append(subset.iloc[0].name)\n\ntest_df = df.loc[test_indices].reset_index(drop=True)\nprint(f\"Test subset: {len(test_df)} samples across all difficulty cells\")\nprint(test_df[[\"id\", \"domain\", \"integration_depth\", \"conflict_level\", \"difficulty_cell\"]].to_string())\n\nrun = cmat_benchmark.run(kbench.llm, test_df)\nrun\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n#== CELL 7: Multi-Model Comparison ======================================================