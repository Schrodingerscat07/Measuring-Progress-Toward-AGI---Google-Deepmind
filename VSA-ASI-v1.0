{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.11.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"datasetVersion","sourceId":15717742,"datasetId":10070151,"databundleVersionId":16658199}],"dockerImageVersionId":31328,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"import io\nfrom PIL import Image\n\ndef load_image_b64(rec: dict) -> str:\n    path = resolve_image_path(rec)\n    try:\n        with Image.open(path) as img:\n            # Strip alpha channels and normalize color profiles\n            if img.mode != \"RGB\":\n                img = img.convert(\"RGB\")\n            \n            # Write to memory buffer as strict PNG\n            buffer = io.BytesIO()\n            img.save(buffer, format=\"PNG\")\n            return base64.b64encode(buffer.getvalue()).decode(\"utf-8\")\n    except Exception as e:\n        raise ValueError(f\"Image normalization failed: {str(e)}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-14T11:04:58.690089Z","iopub.execute_input":"2026-04-14T11:04:58.690367Z","iopub.status.idle":"2026-04-14T11:04:58.695936Z","shell.execute_reply.started":"2026-04-14T11:04:58.690341Z","shell.execute_reply":"2026-04-14T11:04:58.695092Z"}},"outputs":[],"execution_count":4},{"cell_type":"code","source":"import os\nimport json\nimport io\nimport base64\nfrom PIL import Image\n\ndef execute_exhaustive_validation():\n    meta_path = None\n    for root, _, files in os.walk(\"/kaggle/input\"):\n        if \"metadata.jsonl\" in files:\n            meta_path = os.path.join(root, \"metadata.jsonl\")\n            break\n            \n    if not meta_path:\n        print(\"FATAL: metadata.jsonl not found.\")\n        return\n\n    images_dir = os.path.join(os.path.dirname(meta_path), \"images\")\n    \n    records = []\n    with open(meta_path, \"r\") as f:\n        for line in f:\n            line = line.strip()\n            if line:\n                records.append(json.loads(line))\n\n    print(f\"Executing Deep Validation on {len(records)} samples...\\n\")\n    \n    required_keys = [\n        \"id\", \"question\", \"correct_answer\", \"image\", \"salience_level\", \n        \"semantic_level\", \"difficulty_cell\", \"is_control\", \n        \"has_negative_constraint\", \"has_competing_highlight\", \n        \"has_multi_table\", \"font_family\", \"failure_mode_tag\"\n    ]\n    \n    errors = {}\n\n    for rec in records:\n        sample_id = rec.get(\"id\", \"UNKNOWN\")\n        sample_errors = []\n\n        # Schema Verification\n        for key in required_keys:\n            if key not in rec:\n                sample_errors.append(f\"Missing key: {key}\")\n        \n        # I/O and Pixel Array Verification\n        img_filename = rec.get(\"image\")\n        if img_filename:\n            img_path = os.path.join(images_dir, os.path.basename(img_filename))\n            if not os.path.exists(img_path):\n                sample_errors.append(f\"File missing: {img_path}\")\n            else:\n                try:\n                    with Image.open(img_path) as img:\n                        # Force pixel load to detect deep EOF truncations\n                        img.load()\n                        if img.mode != \"RGB\":\n                            img = img.convert(\"RGB\")\n                        buffer = io.BytesIO()\n                        img.save(buffer, format=\"PNG\")\n                        _ = base64.b64encode(buffer.getvalue()).decode(\"utf-8\")\n                except Exception as e:\n                    sample_errors.append(f\"Image fault ({type(e).__name__}): {str(e)}\")\n\n        if sample_errors:\n            errors[sample_id] = sample_errors\n\n    if not errors:\n        print(\"VALIDATION COMPLETE: 0 errors detected across all keys, types, and byte-streams.\")\n        print(\"Dataset is 100% clean. Safe to proceed to main execution.\")\n    else:\n        print(f\"VALIDATION FAILED: Anomalies detected in {len(errors)} samples.\")\n        print(\"-\" * 50)\n        for sid, err_list in errors.items():\n            print(f\"[{sid}]\")\n            for err in err_list:\n                print(f\"  - {err}\")\n\nif __name__ == \"__main__\":\n    execute_exhaustive_validation()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-14T11:10:41.839480Z","iopub.execute_input":"2026-04-14T11:10:41.840122Z","iopub.status.idle":"2026-04-14T11:13:26.562335Z","shell.execute_reply.started":"2026-04-14T11:10:41.840093Z","shell.execute_reply":"2026-04-14T11:13:26.561008Z"}},"outputs":[{"name":"stdout","text":"Executing Deep Validation on 504 samples...\n\nVALIDATION FAILED: Anomalies detected in 1 samples.\n--------------------------------------------------\n[sample_0050]\n  - Image fault (OSError): image file is truncated\n","output_type":"stream"}],"execution_count":6},{"cell_type":"code","source":"import os\nimport json\nimport io\nimport base64\nfrom PIL import Image\n\ndef find_metadata() -> str:\n    for root, _, files in os.walk(\"/kaggle/input\"):\n        for fname in files:\n            if fname == \"metadata.jsonl\":\n                return os.path.join(root, fname)\n    raise FileNotFoundError(\"metadata.jsonl not found under /kaggle/input\")\n\nMETA_PATH  = find_metadata()\nIMAGES_DIR = os.path.join(os.path.dirname(META_PATH), \"images\")\n\ndef load_records() -> list[dict]:\n    records = []\n    with open(META_PATH) as f:\n        for line in f:\n            line = line.strip()\n            if line:\n                records.append(json.loads(line))\n    return records\n\ndef execute_preflight():\n    records = load_records()\n    print(f\"INITIATING PRE-FLIGHT VALIDATION: {len(records)} samples.\\n\")\n    \n    error_log = []\n    \n    for rec in records:\n        sample_id = rec.get(\"id\", \"UNKNOWN_ID\")\n        try:\n            # Test 1: JSON Schema checks\n            _ = rec[\"question\"]\n            _ = rec[\"correct_answer\"]\n            _ = rec[\"image\"]\n            \n            # Test 2: File System & Image Integrity\n            path = os.path.join(IMAGES_DIR, os.path.basename(rec[\"image\"]))\n            if not os.path.exists(path):\n                raise FileNotFoundError(f\"Missing file at {path}\")\n                \n            with Image.open(path) as img:\n                if img.mode != \"RGB\":\n                    img = img.convert(\"RGB\")\n                buffer = io.BytesIO()\n                img.save(buffer, format=\"PNG\")\n                _ = base64.b64encode(buffer.getvalue()).decode(\"utf-8\")\n                \n        except Exception as e:\n            error_log.append((sample_id, type(e).__name__, str(e)))\n\n    if error_log:\n        print(f\"CRITICAL FAILURE: {len(error_log)} invalid samples detected.\")\n        print(\"-\" * 50)\n        for err in error_log:\n            print(f\"[{err[0]}] {err[1]}: {err[2]}\")\n    else:\n        print(\"SYSTEM GREEN: All samples passed local I/O and encoding validation.\")\n        print(\"Proceed to execute primary LLM benchmark script.\")\n\nif __name__ == \"__main__\":\n    execute_preflight()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-14T11:05:04.572554Z","iopub.execute_input":"2026-04-14T11:05:04.572833Z","iopub.status.idle":"2026-04-14T11:08:00.715252Z","shell.execute_reply.started":"2026-04-14T11:05:04.572814Z","shell.execute_reply":"2026-04-14T11:08:00.714271Z"}},"outputs":[{"name":"stdout","text":"INITIATING PRE-FLIGHT VALIDATION: 504 samples.\n\nCRITICAL FAILURE: 1 invalid samples detected.\n--------------------------------------------------\n[sample_0050] OSError: image file is truncated\n","output_type":"stream"}],"execution_count":5},{"cell_type":"code","source":"\"\"\"\nVSA-ASI-v1.0 — Kaggle Benchmarks Task\n=======================================\nTask: Visual Selective Attention — Adversarial Salience Injection\nTrack: Attention\n\"\"\"\n\nimport os\nimport json\nimport base64\nimport re\nimport kaggle_benchmarks as kbench\nfrom kaggle_benchmarks.assertions import AssertionResult\n\n# ── 1. Locate dataset files ───────────────────────────────────────────────────\n\ndef find_metadata() -> str:\n    for root, _, files in os.walk(\"/kaggle/input\"):\n        for fname in files:\n            if fname == \"metadata.jsonl\":\n                return os.path.join(root, fname)\n    raise FileNotFoundError(\"metadata.jsonl not found under /kaggle/input\")\n\nMETA_PATH  = find_metadata()\nIMAGES_DIR = os.path.join(os.path.dirname(META_PATH), \"images\")\n\ndef resolve_image_path(rec: dict) -> str:\n    return os.path.join(IMAGES_DIR, os.path.basename(rec[\"image\"]))\n\ndef load_image_b64(rec: dict) -> str:\n    path = resolve_image_path(rec)\n    with open(path, \"rb\") as f:\n        return base64.b64encode(f.read()).decode(\"utf-8\")\n\n# ── 2. Load records ───────────────────────────────────────────────────────────\n\ndef load_records() -> list[dict]:\n    records = []\n    with open(META_PATH) as f:\n        for line in f:\n            line = line.strip()\n            if line:\n                records.append(json.loads(line))\n    return records\n\nALL_RECORDS = load_records()\n\n# ── 3. Answer normalisation ───────────────────────────────────────────────────\n\ndef normalise(text: str) -> str:\n    t = text.strip().lower()\n    t = re.sub(r\"[,$€£¥]\", \"\", t)\n    t = re.sub(r\"\\s+\", \"\", t)\n    return t\n\ndef answers_match(model_response: str, correct_answer: str) -> bool:\n    norm_response = normalise(model_response)\n    norm_correct  = normalise(correct_answer)\n\n    if norm_response == norm_correct:\n        return True\n\n    numeric_core = re.sub(r\"[^0-9.]\", \"\", norm_correct)\n    if numeric_core and numeric_core in norm_response:\n        return True\n\n    return False\n\n# ── 4. Assertion handler ──────────────────────────────────────────────────────\n\n@kbench.assertions.assertion_handler()\ndef check_attention(\n    sample_id:               str,\n    correct_answer:          str,\n    salience_level:          int,\n    semantic_level:          int,\n    difficulty_cell:         str,\n    is_control:              bool,\n    distractor_value:        str | None,\n    trap_type:               str | None,\n    has_negative_constraint: bool,\n    has_competing_highlight: bool,\n    has_multi_table:         bool,\n    font_family:             str,\n    failure_mode_tag:        str,\n    model_response:          str,\n) -> AssertionResult:\n    \n    passed = answers_match(model_response, correct_answer)\n\n    if passed:\n        outcome = \"correct\"\n    elif distractor_value and answers_match(model_response, distractor_value):\n        outcome = \"distractor_captured\"\n    else:\n        outcome = \"other_error\"\n\n    details = {\n        \"sample_id\":               sample_id,\n        \"model_response\":          model_response.strip(),\n        \"correct_answer\":          correct_answer,\n        \"distractor_value\":        distractor_value,\n        \"outcome\":                 outcome,\n        \"salience_level\":          salience_level,\n        \"semantic_level\":          semantic_level,\n        \"difficulty_cell\":         difficulty_cell,\n        \"is_control\":              is_control,\n        \"trap_type\":               trap_type,\n        \"has_negative_constraint\": has_negative_constraint,\n        \"has_competing_highlight\": has_competing_highlight,\n        \"has_multi_table\":         has_multi_table,\n        \"font_family\":             font_family,\n        \"failure_mode_tag\":        failure_mode_tag,\n    }\n\n    return AssertionResult(\n        passed      = passed,\n        expectation = correct_answer,\n        details     = details,\n    )\n\n# ── 5. Task definition ────────────────────────────────────────────────────────\n\n@kbench.task(\n    name=\"VSA-ASI-v1.0\",\n    description=(\n        \"Visual Selective Attention — Adversarial Salience Injection. \"\n        \"Tests whether frontier multimodal models can extract a correct value \"\n        \"from a data table while ignoring adversarially injected visual distractors.\"\n    )\n)\ndef vsa_asi_task(rec: dict):\n    model = kbench.llms[\"google/gemini-2.5-pro\"]\n\n    b64 = load_image_b64(rec)\n    v_image = kbench.content_types.images.from_base64(b64, format=\"png\")\n\n    question = (\n        f\"{rec['question']}\\n\\n\"\n        \"Remember: ignore any highlighted or boxed figures. \"\n        \"Read the answer directly from the data table cell.\"\n    )\n\n    response = model.prompt(question, image=v_image)\n    model_response = response.text if hasattr(response, 'text') else str(response)\n\n    # State managed internally by SDK. Do not return result.\n    check_attention(\n        sample_id               = rec[\"id\"],\n        correct_answer          = rec[\"correct_answer\"],\n        salience_level          = rec[\"salience_level\"],\n        semantic_level          = rec[\"semantic_level\"],\n        difficulty_cell         = rec[\"difficulty_cell\"],\n        is_control              = rec[\"is_control\"],\n        distractor_value        = rec.get(\"distractor_value\"),\n        trap_type               = rec.get(\"trap_type\"),\n        has_negative_constraint = rec[\"has_negative_constraint\"],\n        has_competing_highlight = rec[\"has_competing_highlight\"],\n        has_multi_table         = rec[\"has_multi_table\"],\n        font_family             = rec[\"font_family\"],\n        failure_mode_tag        = rec[\"failure_mode_tag\"],\n        model_response          = model_response,\n    )\n\nimport time\n\n# ── 6. Execution Loop ─────────────────────────────────────────────────────────\n\nif __name__ == \"__main__\":\n    # Purge the known truncated file\n    safe_records = [rec for rec in ALL_RECORDS if rec.get(\"id\") != \"sample_0050\"]\n    \n    print(f\"Launching Benchmark: VSA-ASI-v1.0\")\n    print(f\"Loaded {len(safe_records)} safe samples.\")\n    \n    for idx, sample in enumerate(safe_records):\n        max_retries = 3\n        for attempt in range(max_retries):\n            try:\n                vsa_asi_task.run(rec=sample)\n                break # Success, exit retry loop\n            \n            except Exception as e:\n                error_str = str(e)\n                # If network timeout or rate limit, back off and retry\n                if \"429\" in error_str or \"503\" in error_str or \"504\" in error_str:\n                    time.sleep((attempt + 1) * 5) # Exponential backoff: 5s, 10s, 15s\n                    if attempt == max_retries - 1:\n                        print(f\"Network fault on {sample.get('id')} after 3 attempts: {e}\")\n                else:\n                    # Unforeseen runtime error; log and skip to prevent deadlock\n                    print(f\"Execution fault on {sample.get('id')}: {e}\")\n                    break \n\n        if (idx + 1) % 50 == 0:\n            print(f\"Processed {idx + 1}/{len(safe_records)} samples...\")\n\n    print(\"BENCHMARK COMPLETE.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-14T11:16:19.309204Z","iopub.execute_input":"2026-04-14T11:16:19.309480Z","iopub.status.idle":"2026-04-14T12:21:28.210581Z","shell.execute_reply.started":"2026-04-14T11:16:19.309460Z","shell.execute_reply":"2026-04-14T12:21:28.209363Z"}},"outputs":[{"output_type":"display_data","data":{"text/html":"<script type=\"esms-options\">{\"shimMode\": true}</script><style>*[data-root-id],\n*[data-root-id] > * {\n  box-sizing: border-box;\n  font-family: var(--jp-ui-font-family);\n  font-size: var(--jp-ui-font-size1);\n  color: var(--vscode-editor-foreground, var(--jp-ui-font-color1));\n}\n\n/* Override VSCode background color */\n.cell-output-ipywidget-background:has(\n  > .cell-output-ipywidget-background > .lm-Widget > *[data-root-id]\n),\n.cell-output-ipywidget-background:has(> .lm-Widget > *[data-root-id]) {\n  background-color: transparent !important;\n}\n</style>"},"metadata":{}},{"output_type":"display_data","data":{"application/javascript":"(function(root) {\n  function now() {\n    return new Date();\n  }\n\n  const force = true;\n  const version = '3.8.1'.replace('rc', '-rc.').replace('.dev', '-dev.');\n  const reloading = false;\n  const Bokeh = root.Bokeh;\n  const BK_RE = /^https:\\/\\/cdn\\.bokeh\\.org\\/bokeh\\/(release|dev)\\/bokeh-/;\n  const PN_RE = /^https:\\/\\/cdn\\.holoviz\\.org\\/panel\\/[^/]+\\/dist\\/panel/i;\n\n  // Set a timeout for this load but only if we are not already initializing\n  if (typeof (root._bokeh_timeout) === \"undefined\" || (force || !root._bokeh_is_initializing)) {\n    root._bokeh_timeout = Date.now() + 5000;\n    root._bokeh_failed_load = false;\n  }\n\n  function run_callbacks() {\n    try {\n      root._bokeh_onload_callbacks.forEach(function(callback) {\n        if (callback != null)\n          callback();\n      });\n    } finally {\n      delete root._bokeh_onload_callbacks;\n    }\n    console.debug(\"Bokeh: all callbacks have finished\");\n  }\n\n  function load_libs(css_urls, js_urls, js_modules, js_exports, Bokeh, callback) {\n    if (css_urls == null) css_urls = [];\n    if (js_urls == null) js_urls = [];\n    if (js_modules == null) js_modules = [];\n    if (js_exports == null) js_exports = {};\n\n    root._bokeh_onload_callbacks.push(callback);\n\n    if (root._bokeh_is_loading > 0) {\n      // Don't load bokeh if it is still initializing\n      console.debug(\"Bokeh: BokehJS is being loaded, scheduling callback at\", now());\n      return null;\n    } else if (js_urls.length === 0 && js_modules.length === 0 && Object.keys(js_exports).length === 0) {\n      // There is nothing to load\n      run_callbacks();\n      return null;\n    }\n\n    function on_load() {\n      root._bokeh_is_loading--;\n      if (root._bokeh_is_loading === 0) {\n        console.debug(\"Bokeh: all BokehJS libraries/stylesheets loaded\");\n        run_callbacks()\n      }\n    }\n    window._bokeh_on_load = on_load\n\n    function on_error(e) {\n      const src_el = e.srcElement\n      console.error(\"failed to load \" + (src_el.href || src_el.src));\n    }\n\n    const skip = [];\n    if (window.requirejs) {\n      window.requirejs.config({'packages': {}, 'paths': {'tabulator': 'https://cdn.jsdelivr.net/npm/tabulator-tables@6.3.1/dist/js/tabulator.min', 'moment': 'https://cdn.jsdelivr.net/npm/luxon/build/global/luxon.min'}, 'shim': {}});\n      require([\"tabulator\"], function(Tabulator) {\n        window.Tabulator = Tabulator\n        on_load()\n      })\n      require([\"moment\"], function(moment) {\n        window.moment = moment\n        on_load()\n      })\n      root._bokeh_is_loading = css_urls.length + 2;\n    } else {\n      root._bokeh_is_loading = css_urls.length + js_urls.length + js_modules.length + Object.keys(js_exports).length;\n    }\n\n    const existing_stylesheets = []\n    const links = document.getElementsByTagName('link')\n    for (let i = 0; i < links.length; i++) {\n      const link = links[i]\n      if (link.href != null) {\n        existing_stylesheets.push(link.href)\n      }\n    }\n    for (let i = 0; i < css_urls.length; i++) {\n      const url = css_urls[i];\n      const escaped = encodeURI(url)\n      if (existing_stylesheets.indexOf(escaped) !== -1) {\n        on_load()\n        continue;\n      }\n      const element = document.createElement(\"link\");\n      element.onload = on_load;\n      element.onerror = on_error;\n      element.rel = \"stylesheet\";\n      element.type = \"text/css\";\n      element.href = url;\n      console.debug(\"Bokeh: injecting link tag for BokehJS style